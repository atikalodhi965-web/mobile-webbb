PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/samz?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend / Admin origins (CORS)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# First admin (used by npm run seed)
ADMIN_NAME=SAMZ Admin
ADMIN_EMAIL=admin@samz.com
ADMIN_PASSWORD=Admin@12345
